# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Supabase: Project Settings -> API. The service-role key bypasses Row Level
# Security, so it lives on the server only and is never committed.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Firebase console -> Project settings -> General -> Project ID.
FIREBASE_PROJECT_ID=

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
# Deployed: your GitHub Pages origin, e.g. https://yourusername.github.io
CORS_ORIGINS=http://localhost:5173

# Set to production on your host.
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.
