# Firebase (login only): Firebase console -> Project settings -> General ->
# Your apps -> Web app. Also enable Authentication -> Sign-in method ->
# Email/Password and Google, and add your site's domain under
# Authentication -> Settings -> Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Leave unset in development (Vite proxies /api to http://localhost:5000).
# In production set it to the API's origin, e.g. https://api.example.com
# VITE_API_URL=
