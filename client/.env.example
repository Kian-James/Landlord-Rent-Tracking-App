# Copy to .env and fill in. .env is git-ignored; this file is committed.
#
# Every VITE_ value is compiled into the built JavaScript and is PUBLIC.
# Never put a key, a password or a connection string in here.

# Firebase console -> Project settings -> General -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Leave unset in development: Vite proxies /api to http://localhost:3000.
# Deployed: your API's public URL, no trailing slash, e.g. https://your-api.onrender.com
# VITE_API_BASE_URL=
