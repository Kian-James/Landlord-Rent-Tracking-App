# Copy to .env and fill in. .env is git-ignored; this file is committed.
#
# Every VITE_ value is compiled into the built JavaScript and is PUBLIC.
# Never put a service-role key, a password or a connection string in here.

# Supabase: Project Settings -> API. Use the anon/public key here, never the
# service-role key - the anon key is meant to be public, the service-role key
# is not.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Leave unset in development: Vite proxies /api to http://localhost:3000.
# Deployed: your API's public URL, no trailing slash, e.g. https://your-api.onrender.com
# VITE_API_BASE_URL=

# Used only by `npm run screenshots` (scripts/screenshot-pages.mjs) to log in
# and capture the pages behind auth. A real Supabase user in this project.
# Leave unset to only screenshot the public login/register pages.
# TEST_EMAIL=
# TEST_PASSWORD=
